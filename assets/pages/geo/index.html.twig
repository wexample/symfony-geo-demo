{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <p class="text-secondary">{{ '@page::intro' | trans }}</p>

    {{ properties([
        { key: '@page::geocoder.label' | trans, value: (geocoder_available ? '@page::geocoder.available' : '@page::geocoder.missing') | trans },
    ]) }}

    {#- Each pin says the place's name and not its address: an entity alone
        would be labelled with its address, the array names it. -#}
    {{ geo_map(places|map(place => { point: place, label: place.name }), { height: '28rem' }) }}

    {{ data_table([
        { key: 'name', label: '@page::column.name' | trans, width: 's', class: 'table--cell--nowrap' },
        { key: 'address', label: '@page::column.address' | trans },
        { key: 'point', label: '@page::column.point' | trans, width: 's', class: 'table--cell--nowrap' },
    ], places|map(place => {
        name: place.name,
        address: place.toStringInline(),
        point: place.geoPoint ? place.geoPoint.latitude ~ ', ' ~ place.geoPoint.longitude : '',
    }), {
        striped: true,
    }) }}
{%- endblock -%}
