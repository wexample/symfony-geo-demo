{
  "name": "wexample/symfony-geo-demo",
  "description": "Demo of symfony-geo: located addresses on a map, and a road between them",
  "version": "2.0.13",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyGeoDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=39.0.3",
    "wexample/symfony-geo": ">=8.0.2",
    "wexample/symfony-geo-ds": ">=3.0.9",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-loader": ">=25.3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}